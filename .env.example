# Set to true to enable the optional AI explanation feature.
LLM_ENABLED=false

# API key for your OpenAI-compatible endpoint.
LLM_API_KEY=your_api_key_here

# Model name to use for the explanation.
LLM_MODEL=gpt-4o-mini

# Base URL for the chat completions endpoint (no trailing slash).
LLM_BASE_URL=https://api.openai.com/v1
